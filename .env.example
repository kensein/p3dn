# Frontend Next.js
# Kosongkan untuk dev lokal; set /p3dn untuk produksi di portal PSIMKG.
NEXT_PUBLIC_BASE_PATH=

# URL backend API (Express). Contoh produksi:
# NEXT_PUBLIC_API_URL=https://psimkg.bmkg.go.id/p3dn-api/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-side fetch (opsional, untuk SSR)
API_BASE_URL=http://127.0.0.1:8000/api

# Port Next.js (produksi: 3002 — jangan pakai 3001 milik portal)
PORT=3000
