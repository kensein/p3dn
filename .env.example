# ============================================================================
# Contoh konfigurasi environment Portal P3DN BMKG (PSIMKG)
# Salin menjadi .env.local untuk pengembangan, atau .env untuk produksi.
#   cp .env.example .env.local
# JANGAN commit file .env / .env.local yang berisi kredensial asli.
# ============================================================================

# --- Base path (sub-path portal) ---------------------------------------------
# Kosongkan untuk dev (aplikasi di root, http://localhost:3000).
# Untuk produksi di balik portal PSIMKG, set ke /p3dn.
NEXT_PUBLIC_BASE_PATH=
# URL publik aplikasi (dipakai untuk dokumentasi/metadata).
APP_URL=http://localhost:3000

# --- Koneksi database PostgreSQL ---------------------------------------------
# Opsi A: variabel terpisah
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bmkg_p3dn
DB_USER=p3dn
DB_PASSWORD=ganti_dengan_password_aman
DB_POOL_MAX=10
DB_SSL=false

# Opsi B (alternatif): satu connection string. Bila diisi, dipakai lebih dahulu.
# DATABASE_URL=postgresql://p3dn:password@localhost:5432/bmkg_p3dn

# --- Runtime -----------------------------------------------------------------
# Port aplikasi Next.js (untuk produksi gunakan 3002 — JANGAN 3001 milik portal).
PORT=3000
NODE_ENV=development
